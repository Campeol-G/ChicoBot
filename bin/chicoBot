#!/usr/bin/env bash
# chicoBot: first-run setup and foreground launcher. Ctrl+C stops the bot.
set -euo pipefail

REPO_ROOT="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd -P)"
ENV_FILE="${CHICOS_BOT_ENV:-${XDG_CONFIG_HOME:-$HOME/.config}/chicos-bot/env}"
BIN_DIR="${XDG_BIN_HOME:-$HOME/.local/bin}"
JAR="$REPO_ROOT/target/chicos-bot.jar"
CONFIG_DIR="$(dirname -- "$ENV_FILE")"
JAVA_ARGS=(--enable-native-access=ALL-UNNAMED -Djava.awt.headless=true)
TEMP_FILES=()

cleanup() {
  local file
  for file in "${TEMP_FILES[@]:-}"; do
    if [[ -n "$file" ]]; then
      rm -f -- "$file"
    fi
  done
  return 0
}

trap cleanup EXIT

new_temp() {
  local file
  file="$(mktemp "$1")"
  TEMP_FILES+=("$file")
  printf '%s' "$file"
}

usage() {
  cat <<'EOF'
chicoBot — chicos-bot setup and foreground launcher

Usage:
  chicoBot            Start the bot (runs setup on the first run)
  chicoBot start      Start the bot
  chicoBot setup      Run or re-run the setup wizard
  chicoBot check      Check prerequisites without changing anything
  chicoBot help       Show this help

The bot runs in the foreground. Press Ctrl+C to stop it.
No daemon or `end` command: for background operation use the systemd unit.
EOF
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

have() {
  command -v "$1" >/dev/null 2>&1
}

java_major() {
  # JAVA_TOOL_OPTIONS/_JAVA_OPTIONS may print a "Picked up..." line first.
  local versions
  versions="$(java -version 2>&1 | sed -n 's/.*version "\([0-9][0-9]*\).*/\1/p')"
  printf '%s' "${versions%%$'\n'*}"
}

check_java() {
  have java || { echo "missing: java"; return 1; }
  local major
  major="$(java_major)"
  if [[ -z "$major" || "$major" -lt 25 ]]; then
    echo "java 25+ required (found ${major:-unknown})"
    return 1
  fi
  echo "java $major"
}

check_maven() {
  if ! have mvn; then
    echo "missing: maven (needed to build the jar)"
    return 1
  fi
  local version major minor
  version="$(mvn -version 2>/dev/null | head -n 1 | awk '{print $3}')"
  major="${version%%.*}"
  minor="${version#*.}"
  minor="${minor%%.*}"
  if [[ -z "$version" ]] || (( major < 3 || (major == 3 && minor < 10) )); then
    echo "maven 3.10+ required (found ${version:-unknown})"
    return 1
  fi
  echo "maven $version"
}

check_tesseract() {
  if ! have tesseract; then
    echo "missing: tesseract (image import will not work)"
    return 1
  fi
  local langs
  langs="$(tesseract --list-langs 2>/dev/null || true)"
  local language
  for language in por eng; do
    if ! grep -qx "$language" <<<"$langs"; then
      echo "missing tesseract language: $language"
      return 1
    fi
  done
  echo "tesseract por+eng"
}

check_env() {
  if [[ ! -f "$ENV_FILE" ]]; then
    echo "missing env: $ENV_FILE"
    return 1
  fi
  local mode
  mode="$(stat -c '%a' "$ENV_FILE" 2>/dev/null || true)"
  if [[ "$mode" != "600" ]]; then
    echo "env mode is ${mode:-unknown}, expected 600"
    return 1
  fi
  if ( set -a; . "$ENV_FILE"; [[ -n "${DISCORD_TOKEN:-}" ]] ); then
    echo "env token set"
  else
    echo "DISCORD_TOKEN missing in $ENV_FILE"
    return 1
  fi
}

check_jar() {
  if [[ -f "$JAR" ]]; then
    echo "jar present"
  else
    echo "missing jar: $JAR"
    return 1
  fi
}

check_cipher() {
  local url=""
  if [[ -f "$ENV_FILE" ]]; then
    url="$( set -a; . "$ENV_FILE"; printf '%s' "${YT_CIPHER_URL:-}" )"
  fi
  if [[ -z "$url" ]]; then
    echo "cipher not configured (optional; YouTube may fail)"
    return 0
  fi
  if ! have curl; then
    echo "curl missing; cannot check cipher"
    return 0
  fi
  local display
  display="$(printf '%s' "$url" | sed -E 's#(://)[^/@]+@#\1#')"
  if curl -fsS -m 3 -o /dev/null -- "$url/"; then
    echo "cipher reachable: $display"
  else
    echo "warning: cipher not reachable: $display"
  fi
}

check() {
  local failed=0
  check_java || failed=1
  check_maven || failed=1
  check_env || failed=1
  check_jar || failed=1
  check_tesseract || true
  check_cipher || true
  if [[ "$failed" -ne 0 ]]; then
    echo "check failed"
    return 1
  fi
  echo "check passed"
}

build_jar() {
  # Test seam: lets the setup smoke verify the env writer without Maven.
  if [[ "${CHICOS_BOT_SKIP_BUILD:-0}" == "1" ]]; then
    echo "build skipped (CHICOS_BOT_SKIP_BUILD=1)"
    return 0
  fi
  have mvn || die "Maven is required to build the jar"
  echo "building $JAR..."
  ( cd "$REPO_ROOT" && mvn -q package -DskipTests )
}

ensure_env() {
  [[ -f "$ENV_FILE" ]] || return 1
  local mode
  mode="$(stat -c '%a' "$ENV_FILE" 2>/dev/null || true)"
  if [[ "$mode" != "600" ]]; then
    echo "warning: env mode ${mode:-unknown}; fixing to 600" >&2
    chmod 600 "$ENV_FILE" || return 1
  fi
  ( set -a; . "$ENV_FILE"; [[ -n "${DISCORD_TOKEN:-}" ]] )
}

env_value() {
  local key="$1"
  if [[ -f "$ENV_FILE" ]]; then
    ( set -a; . "$ENV_FILE"; printf '%s' "${!key:-}" )
  fi
}

ensure_config_dir() {
  if [[ ! -d "$CONFIG_DIR" ]]; then
    mkdir -p "$CONFIG_DIR"
    chmod 700 "$CONFIG_DIR" 2>/dev/null || true
  fi
}

ask() {
  local prompt="$1" default="${2:-}" value=""
  if [[ -n "$default" ]]; then
    read -r -p "$prompt [$default]: " value || true
    printf '%s' "${value:-$default}"
  else
    read -r -p "$prompt: " value || true
    printf '%s' "$value"
  fi
}

ask_optional() {
  local prompt="$1" default="${2:-}" value=""
  if [[ -n "$default" ]]; then
    read -r -p "$prompt [$default, - to clear]: " value || true
    if [[ "$value" == "-" ]]; then
      printf ''
    else
      printf '%s' "${value:-$default}"
    fi
  else
    read -r -p "$prompt (Enter to skip): " value || true
    printf '%s' "$value"
  fi
}

ask_secret_keep() {
  local prompt="$1" current="${2:-}" value=""
  if [[ -n "$current" ]]; then
    read -r -s -p "$prompt [configured, Enter to keep, - to clear]: " value || true
    printf '\n' >&2
    if [[ "$value" == "-" ]]; then
      printf ''
    else
      printf '%s' "${value:-$current}"
    fi
  else
    read -r -s -p "$prompt: " value || true
    printf '\n' >&2
    printf '%s' "$value"
  fi
}

ask_secret() {
  ask_secret_keep "$1" ""
}

ask_yes_no() {
  local prompt="$1" answer=""
  read -r -p "$prompt [y/N]: " answer || true
  [[ "$answer" =~ ^[Yy]$ ]]
}

set_line() {
  local file="$1" key="$2" value="$3" quoted
  quoted="'$(printf '%s' "$value" | sed "s/'/'\\\\''/g")'"
  QUOTED="$quoted" awk -v k="$key" '
    BEGIN { v=ENVIRON["QUOTED"]; done=0 }
    index($0, k "=") == 1 { print k "=" v; done=1; next }
    { print }
    END { if (!done) print k "=" v }
  ' "$file" > "$file.tmp"
  mv "$file.tmp" "$file"
}

write_env() {
  ensure_config_dir
  local old_umask tmp
  old_umask="$(umask)"
  umask 077
  tmp="$(new_temp "$CONFIG_DIR/env.XXXXXX")"
  chmod 600 "$tmp"
  if [[ -f "$ENV_FILE" ]]; then
    cp "$ENV_FILE" "$tmp"
  else
    cp "$REPO_ROOT/.env.example" "$tmp"
  fi
  set_line "$tmp" DISCORD_TOKEN "$DISCORD_TOKEN"
  set_line "$tmp" DEV_GUILD_ID "$DEV_GUILD_ID"
  set_line "$tmp" YT_REFRESH_TOKEN "$YT_REFRESH_TOKEN"
  set_line "$tmp" YT_CIPHER_URL "$YT_CIPHER_URL"
  set_line "$tmp" YT_CIPHER_PASSWORD "$YT_CIPHER_PASSWORD"
  set_line "$tmp" SPOTIFY_CLIENT_ID "$SPOTIFY_CLIENT_ID"
  set_line "$tmp" SPOTIFY_CLIENT_SECRET "$SPOTIFY_CLIENT_SECRET"
  set_line "$tmp" SPOTIFY_REFRESH_TOKEN "$SPOTIFY_REFRESH_TOKEN"
  set_line "$tmp" APPLE_MUSIC_DEVELOPER_TOKEN "$APPLE_DEVELOPER_TOKEN"
  set_line "$tmp" APPLE_MUSIC_STOREFRONT "$APPLE_STOREFRONT"
  set_line "$tmp" APPLE_MUSIC_USER_TOKEN "$APPLE_USER_TOKEN"
  chmod 600 "$tmp"
  mv "$tmp" "$ENV_FILE"
  chmod 600 "$ENV_FILE"
  umask "$old_umask"
}

install_command() {
  mkdir -p "$BIN_DIR"
  ln -sf "$REPO_ROOT/bin/chicoBot" "$BIN_DIR/chicoBot"
  echo "Installed command: $BIN_DIR/chicoBot"
  case ":$PATH:" in
    *":$BIN_DIR:"*) ;;
    *) printf 'Add to PATH: export PATH="%s:$PATH"\n' "$BIN_DIR" ;;
  esac
}

run_youtube_login() {
  [[ -f "$JAR" ]] || build_jar
  ensure_config_dir
  local tmp token
  tmp="$(new_temp "$CONFIG_DIR/yt.XXXXXX")"
  chmod 600 "$tmp"
  if java "${JAVA_ARGS[@]}" -cp "$JAR" dev.chico.bot.source.YoutubeOauthSetup "$tmp"; then
    token="$(sed -n 's/^YT_REFRESH_TOKEN=//p' "$tmp")"
    if [[ -n "$token" ]]; then
      YT_REFRESH_TOKEN="$token"
      echo "YouTube login saved."
    else
      echo "warning: YouTube login returned no token."
    fi
  else
    echo "warning: YouTube login failed; keeping the current token."
  fi
  rm -f "$tmp"
}

run_spotify_login() {
  [[ -f "$JAR" ]] || build_jar
  ensure_config_dir
  local tmp token
  tmp="$(new_temp "$CONFIG_DIR/spotify.XXXXXX")"
  chmod 600 "$tmp"
  if SPOTIFY_CLIENT_ID="$SPOTIFY_CLIENT_ID" \
      java "${JAVA_ARGS[@]}" -cp "$JAR" dev.chico.bot.source.SpotifyOauthSetup "$tmp"; then
    token="$(sed -n 's/^SPOTIFY_REFRESH_TOKEN=//p' "$tmp")"
    if [[ -n "$token" ]]; then
      SPOTIFY_REFRESH_TOKEN="$token"
      echo "Spotify login saved."
    else
      echo "warning: Spotify login returned no token."
    fi
  else
    echo "warning: Spotify login failed; keeping the current token."
  fi
  rm -f "$tmp"
}

setup() {
  [[ -t 0 ]] || die "setup needs a terminal; run 'chicoBot setup' interactively"
  check_java || die "install Java 25+ first"
  if [[ ! -f "$JAR" ]]; then
    check_maven || die "install Maven or provide a built jar first"
  fi

  DISCORD_TOKEN="$(env_value DISCORD_TOKEN)"
  DEV_GUILD_ID="$(env_value DEV_GUILD_ID)"
  YT_REFRESH_TOKEN="$(env_value YT_REFRESH_TOKEN)"
  YT_CIPHER_URL="$(env_value YT_CIPHER_URL)"
  YT_CIPHER_PASSWORD="$(env_value YT_CIPHER_PASSWORD)"
  SPOTIFY_CLIENT_ID="$(env_value SPOTIFY_CLIENT_ID)"
  SPOTIFY_CLIENT_SECRET="$(env_value SPOTIFY_CLIENT_SECRET)"
  SPOTIFY_REFRESH_TOKEN="$(env_value SPOTIFY_REFRESH_TOKEN)"
  APPLE_DEVELOPER_TOKEN="$(env_value APPLE_MUSIC_DEVELOPER_TOKEN)"
  APPLE_STOREFRONT="$(env_value APPLE_MUSIC_STOREFRONT)"
  APPLE_STOREFRONT="${APPLE_STOREFRONT:-us}"
  APPLE_USER_TOKEN="$(env_value APPLE_MUSIC_USER_TOKEN)"

  echo "chicoBot setup — Enter keeps an existing value; secrets are hidden."
  echo

  DISCORD_TOKEN="$(ask_secret_keep "Discord bot token [required]" "$DISCORD_TOKEN")"
  while [[ -z "$DISCORD_TOKEN" ]]; do
    DISCORD_TOKEN="$(ask_secret "Discord bot token [required]")"
    [[ -n "$DISCORD_TOKEN" ]] || echo "The token is required."
  done

  local suggested_cipher=""
  [[ -d "$REPO_ROOT/../yt-cipher" ]] && suggested_cipher="http://localhost:8001"
  YT_CIPHER_URL="$(ask_optional "[required for YouTube] Cipher URL" "${YT_CIPHER_URL:-$suggested_cipher}")"
  if [[ -n "$YT_CIPHER_URL" ]]; then
    YT_CIPHER_PASSWORD="$(ask_secret_keep "Cipher password [optional for no-auth]" "$YT_CIPHER_PASSWORD")"
  else
    YT_CIPHER_PASSWORD=""
    echo "warning: no cipher; YouTube may fail, SoundCloud still works."
  fi

  if ask_yes_no "[optional] Configure YouTube login now?"; then
    run_youtube_login
  fi

  DEV_GUILD_ID="$(ask_optional "[optional] Dev guild id" "$DEV_GUILD_ID")"
  if [[ -n "$DEV_GUILD_ID" && ! "$DEV_GUILD_ID" =~ ^[0-9]{1,19}$ ]]; then
    echo "invalid guild id; clearing it."
    DEV_GUILD_ID=""
  fi

  echo
  echo "[optional] Spotify: user login for owned/collaborative playlists."
  echo "Spotify 2026: public playlist contents are unavailable and Premium cannot be verified."
  local old_spotify_id="$SPOTIFY_CLIENT_ID"
  SPOTIFY_CLIENT_ID="$(ask_optional "Spotify client id" "$SPOTIFY_CLIENT_ID")"
  if [[ "$SPOTIFY_CLIENT_ID" != "$old_spotify_id" ]]; then
    SPOTIFY_REFRESH_TOKEN=""
  fi
  if [[ -n "$SPOTIFY_CLIENT_ID" ]]; then
    SPOTIFY_CLIENT_SECRET="$(ask_secret_keep "Spotify client secret" "$SPOTIFY_CLIENT_SECRET")"
    if [[ -z "$SPOTIFY_CLIENT_SECRET" ]]; then
      echo "Spotify needs both client id and secret; clearing Spotify."
      SPOTIFY_CLIENT_ID=""
      SPOTIFY_CLIENT_SECRET=""
      SPOTIFY_REFRESH_TOKEN=""
    elif ask_yes_no "Run Spotify login now (PKCE)?"; then
      run_spotify_login
    fi
  else
    SPOTIFY_CLIENT_SECRET=""
    SPOTIFY_REFRESH_TOKEN=""
  fi

  echo
  echo "[optional] Apple Music: official API only; no scraping."
  APPLE_DEVELOPER_TOKEN="$(ask_secret_keep "Apple Music developer token" "$APPLE_DEVELOPER_TOKEN")"
  if [[ -n "$APPLE_DEVELOPER_TOKEN" ]]; then
    APPLE_STOREFRONT="$(ask "Apple Music storefront" "${APPLE_STOREFRONT:-us}")"
    APPLE_STOREFRONT="$(printf '%s' "$APPLE_STOREFRONT" | tr '[:upper:]' '[:lower:]')"
    if [[ ! "$APPLE_STOREFRONT" =~ ^[a-z]{2}$ ]]; then
      echo "invalid storefront; using us."
      APPLE_STOREFRONT="us"
    fi
    APPLE_USER_TOKEN="$(ask_secret_keep "Apple Music user token (optional)" "$APPLE_USER_TOKEN")"
  else
    APPLE_STOREFRONT="${APPLE_STOREFRONT:-us}"
    APPLE_USER_TOKEN=""
  fi

  echo
  echo "[required for image import] Tesseract"
  if ! check_tesseract; then
    echo "Install Tesseract with por+eng:"
    echo "  sudo pacman -S tesseract tesseract-data-por tesseract-data-eng"
  fi

  if [[ ! -f "$JAR" ]]; then
    build_jar
  fi
  write_env
  install_command
  echo
  echo "Setup complete. Env: $ENV_FILE (mode 600)."
  echo "Start with: chicoBot"
}

start() {
  if ! ensure_env; then
    [[ -t 0 ]] || die "setup required: run 'chicoBot setup' in a terminal"
    setup
  fi
  if [[ "${CHICOS_BOT_DRY_RUN:-0}" == "1" ]]; then
    # Test seam: prove the env path without launching the bot.
    echo "would exec: CHICOS_BOT_ENV=$ENV_FILE $REPO_ROOT/run.sh"
    return 0
  fi
  [[ -f "$JAR" ]] || build_jar
  CHICOS_BOT_ENV="$ENV_FILE" exec "$REPO_ROOT/run.sh"
}

main() {
  case "${1:-start}" in
    start) start ;;
    setup) setup ;;
    check) check ;;
    help|-h|--help) usage ;;
    *) usage; exit 2 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
