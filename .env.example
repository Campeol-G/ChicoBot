# Copy to ~/.config/chicos-bot/env (mode 600) and fill in real values.
# Never commit real values. YT_REFRESH_TOKEN comes from the OAuth device flow
# (see README); leave it empty for unauthenticated YouTube access.
DISCORD_TOKEN=
DEV_GUILD_ID=
YT_REFRESH_TOKEN=
# Remote cipher for YouTube playback (see README). Empty = local cipher.
YT_CIPHER_URL=
YT_CIPHER_PASSWORD=
# Optional Spotify Web API. Set client id + secret together; the refresh token
# enables user mode for owned/collaborative playlists (see README).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Optional Apple Music API (developer token for catalog playlists; user token
# for library playlists). See README.
APPLE_MUSIC_DEVELOPER_TOKEN=
APPLE_MUSIC_STOREFRONT=us
APPLE_MUSIC_USER_TOKEN=
OCR_LANGS=por+eng
OCR_TIMEOUT_MS=8000
OCR_MAX_CONCURRENCY=2
# Otsu binarization only for dark-background screenshots (white prints keep
# the old path). Set false to disable the v1.2 dark-print improvement.
OCR_BINARIZE_DARK=true
IMG_MAX_BYTES=8388608
IMG_MAX_PIXELS=16777216
IMPORT_MAX_TRACKS=50
IMPORT_SESSION_TTL_S=300
COOLDOWN_USER_S=15
QUEUE_MAX=50
IDLE_DISCONNECT_S=420
PAUSED_DISCONNECT_S=2700
MATCH_THRESHOLD=0.35
PARALLEL_SEARCH=true
RESOLVE_TIMEOUT_MS=8000
RESOLVE_CONCURRENCY=4
SOURCE_FAILURE_THRESHOLD=3
SOURCE_DEGRADED_COOLDOWN_S=300
PLAY_COOLDOWN_S=5
LOG_LEVEL=INFO
