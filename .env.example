# Copy to ~/.config/chicos-bot/env (mode 600) and fill in real values.
# Never commit real values. YT_REFRESH_TOKEN comes from the OAuth device flow
# (see README); leave it empty for unauthenticated YouTube access.
DISCORD_TOKEN=
DEV_GUILD_ID=
YT_REFRESH_TOKEN=
OCR_LANGS=por+eng
OCR_TIMEOUT_MS=8000
OCR_MAX_CONCURRENCY=2
IMG_MAX_BYTES=8388608
IMG_MAX_PIXELS=16777216
IMPORT_MAX_TRACKS=25
IMPORT_SESSION_TTL_S=300
COOLDOWN_USER_S=15
QUEUE_MAX=200
IDLE_DISCONNECT_S=300
MATCH_THRESHOLD=0.0
RESOLVE_TIMEOUT_MS=8000
RESOLVE_CONCURRENCY=4
SOURCE_FAILURE_THRESHOLD=3
SOURCE_DEGRADED_COOLDOWN_S=300
PLAY_COOLDOWN_S=5
LOG_LEVEL=INFO
